#!/bin/sh
# Launch Skaar from anywhere (installed as `skaar` by scripts/install-command.sh).
#   skaar              build if needed, then play (starts at the main menu)
#   skaar dev          the auto rebuild loop (scripts/dev-watch.sh)
#   skaar map <name>   build if needed, then play straight into a map
#   skaar build [fast|safe]
#   skaar app [dir]    build a self-contained Skaar.app (default: dist/)
#   skaar update       pull the latest code, then rebuild
#   skaar smoke        pre-commit smoke test
#   skaar watch        filtered live log of the running game
#   skaar crash        show the newest crash report
# Errors and warnings from the game stream into this terminal while it runs;
# the full log is in logs/session-*.log. SKAAR_HOME overrides the repo path.
set -u

SKAAR_HOME=${SKAAR_HOME:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
[ -f "$SKAAR_HOME/scripts/lib.sh" ] || { echo "skaar: repo not found at $SKAAR_HOME (set SKAAR_HOME)" >&2; exit 1; }
# lib.sh derives REPO from $0, which is this script in scripts/
. "$SKAAR_HOME/scripts/lib.sh"

# ---- look ---------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    TTY=1
    EMBER=$(printf '\033[38;2;242;98;46m'); CREAM=$(printf '\033[38;2;235;230;219m')
    SOFT=$(printf '\033[38;2;150;146;139m'); RED=$(printf '\033[38;2;232;112;112m')
    AMBER=$(printf '\033[38;2;230;190;120m'); BOLD=$(printf '\033[1m'); OFF=$(printf '\033[0m')
else
    TTY=0; EMBER=; CREAM=; SOFT=; RED=; AMBER=; BOLD=; OFF=
fi

LABEL_W=12
now_ms() { perl -MTime::HiRes=time -e 'printf "%d", time * 1000' 2>/dev/null || echo "$(( $(date +%s) * 1000 ))"; }
elapsed() {
    awk -v a="$1" -v b="$(now_ms)" 'BEGIN { s = (b - a) / 1000;
        if (s < 60) printf "%.1fs", s; else printf "%dm %02ds", s / 60, s % 60 }'
}
pad() { printf "%-${LABEL_W}s" "$1"; }

# row <icon> <label> <detail> [meta]
row() { printf '  %s %s%s%s  %s%s%s\n' "$1" "$CREAM" "$(pad "$2")" "$OFF" "$3" "${4:+  $SOFT$4}" "$OFF"; }
ok()   { row "${CREAM}✓${OFF}" "$@"; }
bad()  { row "${RED}✗${OFF}" "$1" "$RED$2$OFF" "${3:-}"; }
warn() { row "${AMBER}!${OFF}" "$1" "$AMBER$2$OFF" "${3:-}"; }
info() { row "${SOFT}·${OFF}" "$1" "$SOFT$2$OFF" "${3:-}"; }

cursor_hide() { [ "$TTY" = 1 ] && printf '\033[?25l'; }
cursor_show() { [ "$TTY" = 1 ] && printf '\033[?25h'; }

# spin <label> <pid> <detail command>: animate until pid exits, return its status
spin() {
    label=$1 pid=$2 detail_cmd=$3
    if [ "$TTY" = 1 ]; then
        cursor_hide
        i=0
        while kill -0 "$pid" 2>/dev/null; do
            case $((i % 10)) in
                0) f=⠋ ;; 1) f=⠙ ;; 2) f=⠹ ;; 3) f=⠸ ;; 4) f=⠼ ;;
                5) f=⠴ ;; 6) f=⠦ ;; 7) f=⠧ ;; 8) f=⠇ ;; *) f=⠏ ;;
            esac
            printf '\r\033[2K  %s%s%s %s%s%s  %s%s%s' "$EMBER" "$f" "$OFF" "$CREAM" "$(pad "$label")" "$OFF" \
                "$SOFT" "$(eval "$detail_cmd" 2>/dev/null | cut -c1-56)" "$OFF"
            i=$((i + 1))
            sleep 0.08
        done
        printf '\r\033[2K'
        cursor_show
    fi
    wait "$pid"
}

intro() {
    mode=$1
    rev=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo "?")
    version=$(sed -n 's/^set(PROJECT_VERSION \(.*\))/\1/p' "$REPO/cmake/identity.cmake")
    echo
    # the mark, revealed a line at a time
    while IFS= read -r line; do
        printf '  %s%s%s\n' "$EMBER" "$line" "$OFF"
        [ "$TTY" = 1 ] && sleep 0.025
    done < "$REPO/misc/skaar/mark-braille.txt"
    echo
    printf '  %s%sskaar%s  %s%s%s\n' "$BOLD" "$CREAM" "$OFF" "$SOFT" "$mode" "$OFF"
    printf '  %sv%s · %s · aim / movement · %s %s%s\n' "$SOFT" "$version" "$rev" "$OS" "$(uname -m)" "$OFF"
    echo
}

# ---- steps ----------------------------------------------------------------------
toolchain() {
    for tool in cmake cc; do
        command -v "$tool" >/dev/null 2>&1 || { bad toolchain "$tool not found (see docs/build-macos.md)"; exit 1; }
    done
    cc_ver=$(cc --version 2>/dev/null | head -1 | sed -E 's/.*version ([0-9]+(\.[0-9]+)?).*/\1/')
    cm_ver=$(cmake --version | head -1 | awk '{print $3}')
    gen=make; command -v ninja >/dev/null 2>&1 && gen=ninja
    if [ "$OS" = Darwin ]; then
        # From macOS 26 on, Xcode and macOS share a major version; older
        # Command Line Tools break lldb and ASan (docs/macos-notes.md)
        os_major=$(sw_vers -productVersion | cut -d. -f1)
        clt_major=$(pkgutil --pkg-info=com.apple.pkg.CLTools_Executables 2>/dev/null | sed -n 's/^version: \([0-9]*\).*/\1/p')
        if [ -n "$clt_major" ] && [ "$os_major" -ge 26 ] && [ "$clt_major" -lt "$os_major" ]; then
            warn toolchain "Command Line Tools $clt_major on macOS $os_major: lldb and ASan disabled" "update: softwareupdate -i \"Command Line Tools for Xcode $os_major.0-$os_major.0\""
            return
        fi
    fi
    ok toolchain "clang $cc_ver · cmake $cm_ver · $gen"
}

build_step() {
    config=$1
    log="$LOGS/skaar-build.log"
    mkdir -p "$LOGS"
    t0=$(now_ms)
    "$REPO/scripts/build.sh" "$config" > "$log" 2>&1 &
    # ninja prints [done/total]; show it with the file being built
    if spin build $! "tail -n 1 '$log' | sed -E -n 's|^\\[([0-9]+/[0-9]+)\\] [A-Za-z ]+ (CXX \\|C )?(object )?.*/([^/]+)\$|\\1  \\4|p'"; then
        compiled=$(grep -c -E '^\[([0-9]+/[0-9]+| *[0-9]+%)\] Building' "$log")
        if [ "$compiled" -gt 0 ]; then
            ok build "$config build ready ($compiled files compiled)" "$(elapsed "$t0")"
        else
            ok build "$config build up to date" "$(elapsed "$t0")"
        fi
    else
        bad build "build failed" "$(elapsed "$t0")"
        grep -v -E '^(ccache |/usr/bin/|/Library/|/opt/|\[[0-9]+/[0-9]+\])' "$log" |
            grep -E -A3 '(^|[^a-z])error:|CMake Error' | grep -v '^--$' | head -30 | sed "s|^|    $RED|;s|\$|$OFF|"
        printf '    %sfull log: %s%s\n\n' "$SOFT" "$log" "$OFF"
        exit 1
    fi
}

newest_crash() { ls -t "$LOGS"/crash-*.txt 2>/dev/null | head -1; }

play() {
    t0=$(now_ms)
    crash_before=$(newest_crash)
    BIN=$(client_bin fast)

    if pgrep -f "$BIN" >/dev/null 2>&1; then
        bad launch "Skaar is already running (quit it first, or use: skaar watch)"
        exit 1
    fi
    rm -f "$(pipe_path)"    # stale pipe from a killed session

    "$REPO/scripts/dev.sh" fast "$@" > /dev/null 2>&1 &
    DEV_PID=$!
    spin launch "$DEV_PID" "[ -p '$(pipe_path)' ] && echo 'window up' || echo 'starting engine…'" &
    SPIN_PID=$!
    n=0
    while [ ! -p "$(pipe_path)" ] && kill -0 "$DEV_PID" 2>/dev/null && [ "$n" -lt 150 ]; do sleep 0.1; n=$((n + 1)); done
    kill "$SPIN_PID" 2>/dev/null; wait "$SPIN_PID" 2>/dev/null
    [ "$TTY" = 1 ] && printf '\r\033[2K' && cursor_show

    if ! kill -0 "$DEV_PID" 2>/dev/null; then
        bad launch "the game exited during startup" "$(elapsed "$t0")"
        printf '    %slog: %s%s\n\n' "$SOFT" "$LOGS/latest.log" "$OFF"
        exit 1
    fi
    ok launch "$(basename "$BIN") · $(readlink "$LOGS/latest.log")" "$(elapsed "$t0")"
    info live "errors and warnings stream here · Ctrl+C quits"
    echo

    WATCH_NO_HEADER=1 "$REPO/scripts/watch.sh" &
    WATCH_PID=$!

    trap 'send_cmd quit; sleep 1; pkill -TERM -f "$BIN" 2>/dev/null' INT TERM
    wait "$DEV_PID" 2>/dev/null
    trap - INT TERM

    sleep 0.3
    exec 3>&2 2>/dev/null   # no "Terminated" job notice for the watcher
    kill "$WATCH_PID"
    pkill -f "tail -n 0 -F $LOGS/latest.log"
    wait "$WATCH_PID"
    exec 2>&3 3>&-
    echo
    crash_after=$(newest_crash)
    if [ -n "$crash_after" ] && [ "$crash_after" != "$crash_before" ]; then
        bad exited "crashed · $crash_after" "$(elapsed "$t0")"
        printf '    %spaste that file to the agent; run: skaar crash%s\n\n' "$SOFT" "$OFF"
        exit 1
    fi
    ok exited "session over" "$(elapsed "$t0")"
    echo
}

# ---- commands --------------------------------------------------------------------
cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
    "")
        intro play
        toolchain
        build_step fast
        play --menu
        ;;
    map)
        [ $# -ge 1 ] || { echo "usage: skaar map <name>" >&2; exit 1; }
        name=$1; shift
        intro "play · $name"
        toolchain
        build_step fast
        play +devmap "$name" "$@"
        ;;
    dev)
        intro dev
        toolchain
        exec "$REPO/scripts/dev-watch.sh" "$@"
        ;;
    build)
        intro build
        toolchain
        build_step "${1:-fast}"
        echo
        ;;
    app)
        intro app
        toolchain
        exec "$REPO/scripts/package-app.sh" "$@"
        ;;
    update)
        intro update
        git -C "$REPO" pull --ff-only || { bad update "git pull failed (local changes?)"; exit 1; }
        ok update "now at $(git -C "$REPO" log -1 --format='%h %s' | cut -c1-60)"
        toolchain
        build_step fast
        echo
        ;;
    smoke)
        intro smoke
        exec "$REPO/scripts/smoke.sh"
        ;;
    watch)
        exec "$REPO/scripts/watch.sh" "$@"
        ;;
    crash)
        f=$(newest_crash)
        [ -n "$f" ] || { echo "no crash reports in $LOGS"; exit 0; }
        printf '%s%s%s\n\n' "$SOFT" "$f" "$OFF"
        cat "$f"
        ;;
    -h|--help|help)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        echo "skaar: unknown command '$cmd' (try: skaar help)" >&2
        exit 1
        ;;
esac
